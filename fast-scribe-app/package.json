{
  "name": "fast-scribe-app",
  "private": true,
  "version": "0.0.0",
  "description": "Desktop app for bulk audio transcription with Azure OpenAI.",
  "author": "PalmNiklasSPP",
  "repository": {
    "type": "git",
    "url": "https://github.com/PalmNiklasSPP/fast-scribe.git"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .\"",
    "build": "tsc -b && vite build",
    "build:electron": "tsc -b && vite build && electron-builder --publish never",
    "build:win": "npm run build && electron-builder --win nsis --publish never",
    "build:mac": "npm run build && electron-builder --mac dmg --publish never",
    "build:linux": "npm run build && electron-builder --linux AppImage --publish never",
    "lint": "oxlint",
    "test": "node --test electron/*.test.cjs",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.fastscribe.app",
    "productName": "Fast Scribe",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "icon": "public/icon.png",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!electron/*.test.cjs",
      "public/**/*",
      "THIRD_PARTY_NOTICES.md"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "PalmNiklasSPP",
        "repo": "fast-scribe"
      }
    ]
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-store": "^11.0.2",
    "ffmpeg-static": "^5.3.0",
    "lucide-react": "^1.33.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.75.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "wait-on": "^9.1.0"
  }
}
